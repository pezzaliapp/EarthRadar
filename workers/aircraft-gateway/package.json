{
  "name": "earthradar-aircraft-gateway",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "EarthRadar — gateway Cloudflare Worker per il traffico aereo ADS-B (FlyItalyADSB, CC BY-SA 4.0): CORS, validazione, normalizzazione, cache best-effort.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.141.0"
  }
}
