# NASA general API key (APOD, EPIC, NeoWs). Fallback DEMO_KEY funziona ma rate-limited.
VITE_NASA_API_KEY=DEMO_KEY

# NASA FIRMS Active Fires. Free ma richiede una map key PERSONALE — ognuno
# genera la propria, NON condividere e NON committare la tua nel repo:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Se la variabile è vuota l'app fa fallback automatico al layer GIBS Active
# Fires (giornaliero, no key) e mostra una banner con la CTA per registrarne
# una. Il deploy in produzione (GitHub Pages) NON include una key.
VITE_FIRMS_MAP_KEY=

# OpenSky Network (opzionale, anonimo è rate-limited a 400 richieste/giorno).
VITE_OPENSKY_USERNAME=
VITE_OPENSKY_PASSWORD=
